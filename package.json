{
  "name": "dexforge",
  "version": "0.1.0",
  "description": "Build your Pokémon team for any main-series game: stats, type weaknesses, coverage, encounter locations and gym leader matchups. Fan-made, open source.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hell-over-studios/dexforge.git"
  },
  "homepage": "https://github.com/hell-over-studios/dexforge#readme",
  "bugs": "https://github.com/hell-over-studios/dexforge/issues",
  "keywords": [
    "pokemon",
    "pokeapi",
    "astro",
    "team-builder",
    "fan-project"
  ],
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "tsx scripts/build.ts",
    "data:check": "tsx scripts/validate.ts",
    "pre-commit": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "astro": "^5.15.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
