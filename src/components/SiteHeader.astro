---
/**
 * Masthead (ADR-012 «Revista»): a black press bar with the anvil-Pokédex mark
 * and the Anton wordmark, plus a yellow cover strip that scrolls away.
 */
import { withBase } from '../lib/paths';
import LogoMark from './LogoMark.astro';

const home = withBase('');
const games = `${home}#juegos`;
const how = `${home}#como-funciona`;
const github = 'https://github.com/hell-over-studios/dexforge';
const navLink =
  'kicker text-sm text-paper-100 underline-offset-[6px] decoration-2 decoration-ember-500 transition-colors hover:text-ember-500 hover:underline';
---

<header class="sticky top-0 z-40 border-b-[3px] border-ink-950 bg-forest-950 forest-grain">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a
      href={home}
      class="group flex min-w-0 items-center gap-3 focus-visible:outline-offset-4"
      aria-label="Dexforge — inicio"
    >
      <span
        class="grid size-11 shrink-0 place-items-center border-2 border-paper-50 bg-ember-500 transition-transform duration-150 group-hover:-rotate-3"
      >
        <LogoMark class="h-7 w-9" />
      </span>
      <span class="flex min-w-0 flex-col">
        <span
          class="font-headline text-[1.9rem] leading-none tracking-wide text-ember-500 uppercase transition-colors group-hover:text-paper-50"
        >
          Dexforge
        </span>
        <span
          class="hidden truncate kicker text-[10px] leading-tight text-paper-300 sm:block"
          data-i18n="mast.tagline">Guía de equipos por juego</span
        >
      </span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Principal">
      <a href={games} class={navLink} data-i18n="nav.games">Juegos</a>
      <a href={how} class={navLink} data-i18n="nav.how">Cómo funciona</a>
      <a href={github} class={navLink} rel="noopener noreferrer" target="_blank"
        >GitHub <span aria-hidden="true">↗</span></a
      >
    </nav>

    <button
      id="lang-toggle"
      type="button"
      class="min-h-9 shrink-0 cursor-pointer border-2 border-paper-50 bg-ember-500 px-3 kicker text-xs text-ink-950 transition-colors hover:bg-magenta-500 hover:text-paper-50"
    >
      English
    </button>
  </div>
</header>

<div class="border-b-[3px] border-ink-950 bg-ember-500" aria-hidden="true">
  <p
    class="mx-auto flex max-w-6xl flex-wrap gap-x-6 gap-y-0.5 overflow-hidden px-5 py-1.5 kicker text-[11px] text-ink-950 sm:px-8"
  >
    <span data-i18n="strip.charts">Tablas de tipos exactas por generación</span>
    <span class="hidden sm:inline" data-i18n="strip.local"
      >Sin cuentas: se guarda en tu navegador</span
    >
    <span class="hidden lg:inline" data-i18n="strip.fans">Hecho por fans, código abierto</span>
  </p>
</div>
