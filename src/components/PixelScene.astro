---
export interface SceneMon {
  artwork: string;
  name: string;
  left: string;
  bottom: string;
  width: string;
  z?: number;
  delay?: string;
}

interface Props {
  variant: 'hero' | 'kanto' | 'johto' | 'hoenn';
  mons: SceneMon[];
  class?: string;
}

const { variant, mons, class: className } = Astro.props;
---

<div class:list={['pixel-scene', `pixel-scene--${variant}`, className]}>
  <span class="pixel-scene__sun" aria-hidden="true"></span>
  <span class="pixel-scene__cloud pixel-scene__cloud--a" aria-hidden="true"></span>
  <span class="pixel-scene__cloud pixel-scene__cloud--b" aria-hidden="true"></span>

  <span class="pixel-scene__hill pixel-scene__hill--far" aria-hidden="true"></span>
  <span class="pixel-scene__hill pixel-scene__hill--mid" aria-hidden="true"></span>

  <span class="pixel-scene__tree" style="left: 3%; bottom: 22%; --s: 0.72" aria-hidden="true"
  ></span>
  <span class="pixel-scene__tree" style="left: 12%; bottom: 18%; --s: 1" aria-hidden="true"></span>
  <span class="pixel-scene__tree" style="left: 78%; bottom: 19%; --s: 0.9" aria-hidden="true"
  ></span>
  <span class="pixel-scene__tree" style="left: 89%; bottom: 24%; --s: 0.64" aria-hidden="true"
  ></span>

  <span class="pixel-scene__ground" aria-hidden="true"></span>

  {
    mons.map((mon) => (
      <div
        class="pixel-scene__mon"
        style={`left:${mon.left};bottom:${mon.bottom};width:${mon.width};z-index:${mon.z ?? 4};`}
      >
        <span class="pixel-scene__mon-shadow" aria-hidden="true" />
        <img
          src={mon.artwork}
          alt={mon.name}
          width="256"
          height="256"
          loading={variant === 'hero' ? 'eager' : 'lazy'}
          decoding="async"
          class="pixel-scene__mon-img"
          style={`animation-delay:${mon.delay ?? '0s'};`}
        />
      </div>
    ))
  }

  <span
    class="pixel-scene__firefly"
    style="left: 22%; top: 48%; animation-delay: 0s"
    aria-hidden="true"></span>
  <span
    class="pixel-scene__firefly"
    style="left: 44%; top: 34%; animation-delay: 0.8s"
    aria-hidden="true"></span>
  <span
    class="pixel-scene__firefly"
    style="left: 68%; top: 52%; animation-delay: 1.6s"
    aria-hidden="true"></span>
  <span
    class="pixel-scene__firefly"
    style="left: 84%; top: 40%; animation-delay: 2.4s"
    aria-hidden="true"></span>
  <span class="pixel-scene__grass" aria-hidden="true"></span>
</div>

<style>
  .pixel-scene {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--scene-sky-1);
    background-image: linear-gradient(
      180deg,
      var(--scene-sky-1) 0 30%,
      var(--scene-sky-2) 30% 48%,
      var(--scene-sky-3) 48% 58%,
      var(--scene-horizon) 58% 64%,
      transparent 64%
    );
  }

  .pixel-scene--hero {
    font-size: 42px;
    --scene-sky-1: #0b2726;
    --scene-sky-2: #15463c;
    --scene-sky-3: #2d6a52;
    --scene-horizon: #edc07a;
    --scene-hill-far: #2b5c46;
    --scene-hill-mid: #1f4a37;
    --scene-ground: #173b2b;
    --scene-tree: #123c2b;
    --scene-tree-light: #1f5a3a;
    --scene-cloud: #f5e8cc;
    --scene-sun: #ffe1a3;
  }

  .pixel-scene--kanto {
    font-size: 22px;
    --scene-sky-1: #2a1626;
    --scene-sky-2: #6b2830;
    --scene-sky-3: #b44d34;
    --scene-horizon: #f0ad62;
    --scene-hill-far: #5c3a2a;
    --scene-hill-mid: #3d2a22;
    --scene-ground: #25301c;
    --scene-tree: #26341d;
    --scene-tree-light: #3a4b27;
    --scene-cloud: #f7d9b0;
    --scene-sun: #ffd27a;
  }

  .pixel-scene--johto {
    font-size: 22px;
    --scene-sky-1: #241f2b;
    --scene-sky-2: #4f352b;
    --scene-sky-3: #9a5a2c;
    --scene-horizon: #f2c46a;
    --scene-hill-far: #6a4a24;
    --scene-hill-mid: #3f331d;
    --scene-ground: #20301c;
    --scene-tree: #2c3a1d;
    --scene-tree-light: #43532a;
    --scene-cloud: #f8e2b6;
    --scene-sun: #ffd98b;
  }

  .pixel-scene--hoenn {
    font-size: 22px;
    --scene-sky-1: #0a2a33;
    --scene-sky-2: #135246;
    --scene-sky-3: #2a7a5c;
    --scene-horizon: #f6c77a;
    --scene-hill-far: #2b5e52;
    --scene-hill-mid: #173f36;
    --scene-ground: #123a2a;
    --scene-tree: #0f3b2a;
    --scene-tree-light: #1d5a3a;
    --scene-cloud: #e9f0d4;
    --scene-sun: #ffe6a8;
  }

  /* Card scenes stay quiet: the featured Pokémon is the only star. */
  .pixel-scene:not(.pixel-scene--hero) .pixel-scene__sun,
  .pixel-scene:not(.pixel-scene--hero) .pixel-scene__cloud {
    display: none;
  }

  .pixel-scene__sun {
    position: absolute;
    top: 14%;
    right: 13%;
    z-index: 0;
    width: 2.3em;
    height: 2.3em;
    background: var(--scene-sun);
    opacity: 0.92;
    clip-path: polygon(
      30% 0,
      70% 0,
      70% 10%,
      85% 10%,
      85% 30%,
      100% 30%,
      100% 70%,
      85% 70%,
      85% 90%,
      70% 90%,
      70% 100%,
      30% 100%,
      30% 90%,
      15% 90%,
      15% 70%,
      0 70%,
      0 30%,
      15% 30%,
      15% 10%,
      30% 10%
    );
  }

  .pixel-scene__cloud {
    position: absolute;
    z-index: 0;
    width: 3.2em;
    height: 0.85em;
    background: var(--scene-cloud);
    opacity: 0.3;
    clip-path: polygon(
      0 100%,
      0 55%,
      14% 55%,
      14% 32%,
      38% 32%,
      38% 14%,
      66% 14%,
      66% 32%,
      88% 32%,
      88% 55%,
      100% 55%,
      100% 100%
    );
  }

  .pixel-scene__cloud--a {
    top: 16%;
    left: 7%;
  }

  .pixel-scene__cloud--b {
    top: 26%;
    right: 34%;
    transform: scale(0.55);
    opacity: 0.22;
  }

  .pixel-scene__hill {
    position: absolute;
    left: 0;
    right: 0;
  }

  .pixel-scene__hill--far {
    bottom: 20%;
    z-index: 1;
    height: 38%;
    background: var(--scene-hill-far);
    clip-path: polygon(
      0 72%,
      7% 72%,
      7% 58%,
      15% 58%,
      15% 44%,
      26% 44%,
      26% 56%,
      37% 56%,
      37% 40%,
      50% 40%,
      50% 54%,
      61% 54%,
      61% 46%,
      72% 46%,
      72% 60%,
      84% 60%,
      84% 50%,
      92% 50%,
      92% 66%,
      100% 66%,
      100% 100%,
      0 100%
    );
  }

  .pixel-scene__hill--mid {
    bottom: 8%;
    z-index: 2;
    height: 30%;
    background: var(--scene-hill-mid);
    clip-path: polygon(
      0 62%,
      10% 62%,
      10% 50%,
      22% 50%,
      22% 40%,
      34% 40%,
      34% 54%,
      48% 54%,
      48% 44%,
      60% 44%,
      60% 58%,
      74% 58%,
      74% 48%,
      86% 48%,
      86% 60%,
      100% 60%,
      100% 100%,
      0 100%
    );
  }

  .pixel-scene__ground {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    height: 26%;
    background-color: var(--scene-ground);
  }

  .pixel-scene__ground::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 26%;
    background: rgba(8, 19, 13, 0.16);
  }

  .pixel-scene__tree {
    position: absolute;
    z-index: 3;
    width: 1em;
    height: 1.9em;
    transform: scale(var(--s, 1));
    transform-origin: bottom center;
  }

  .pixel-scene__tree::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 22%;
    height: 36%;
    transform: translateX(-50%);
    background: #4a2f1c;
  }

  .pixel-scene__tree::after {
    content: '';
    position: absolute;
    inset: 0 0 28% 0;
    background: linear-gradient(90deg, var(--scene-tree-light) 0 28%, var(--scene-tree) 28% 100%);
    clip-path: polygon(
      38% 0,
      62% 0,
      62% 10%,
      75% 10%,
      75% 22%,
      88% 22%,
      88% 36%,
      100% 36%,
      100% 62%,
      88% 62%,
      88% 74%,
      75% 74%,
      75% 86%,
      62% 86%,
      62% 100%,
      38% 100%,
      38% 86%,
      25% 86%,
      25% 74%,
      12% 74%,
      12% 62%,
      0 62%,
      0 36%,
      12% 36%,
      12% 22%,
      25% 22%,
      25% 10%,
      38% 10%
    );
  }

  .pixel-scene__mon {
    position: absolute;
    line-height: 0;
    filter: drop-shadow(4px 5px 0 rgba(8, 19, 13, 0.35));
  }

  .pixel-scene__mon-img {
    width: 100%;
    height: auto;
    animation: scene-bob 3.4s ease-in-out infinite;
  }

  @keyframes scene-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  .pixel-scene__mon-shadow {
    position: absolute;
    right: 16%;
    bottom: -2%;
    left: 16%;
    height: 9%;
    background: rgba(8, 19, 13, 0.35);
    clip-path: polygon(
      20% 0,
      80% 0,
      80% 20%,
      100% 20%,
      100% 80%,
      80% 80%,
      80% 100%,
      20% 100%,
      20% 80%,
      0 80%,
      0 20%,
      20% 20%
    );
  }

  .pixel-scene__firefly {
    position: absolute;
    z-index: 6;
    width: 0.12em;
    height: 0.12em;
    background: #ffd08a;
    box-shadow: 0 0 0 0.08em rgba(255, 180, 84, 0.18);
    animation: scene-flicker 4s steps(4) infinite;
  }

  @keyframes scene-flicker {
    0%,
    100% {
      opacity: 0.25;
    }
    45% {
      opacity: 0.9;
    }
    60% {
      opacity: 0.4;
    }
  }

  .pixel-scene__grass {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 5;
    height: 9%;
    background-image:
      linear-gradient(
        90deg,
        transparent 0 0.35em,
        var(--scene-ground) 0.35em 0.45em,
        transparent 0.45em
      ),
      linear-gradient(
        90deg,
        transparent 0 0.65em,
        var(--scene-tree) 0.65em 0.78em,
        transparent 0.78em
      );
    background-size:
      1.1em 0.45em,
      1.5em 0.6em;
    background-position:
      0 100%,
      0.3em 100%;
    background-repeat: repeat-x;
  }

  @media (min-width: 640px) {
    .pixel-scene--hero {
      font-size: 54px;
    }
  }
</style>
