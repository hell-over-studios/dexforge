---
import { withBase } from '../lib/paths';
---

<footer class="border-t-2 border-forest-800 bg-forest-950">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:px-8 md:grid-cols-[1.5fr_1fr]">
    <div>
      <a
        href={withBase('')}
        class="inline-flex items-center gap-2 font-display text-lg text-paper-100 underline-offset-4 hover:text-ember-300 hover:underline"
      >
        <span aria-hidden="true" class="inline-block size-2 bg-ember-500"></span>
        Dexforge
      </a>
      <p class="mt-3 max-w-xl text-xs leading-relaxed text-paper-400" data-i18n="footer.disclaimer">
        Proyecto de fans, sin afiliación con Nintendo, Game Freak ni The Pokémon Company. Pokémon y
        todos los nombres/efigies relacionados son propiedad de sus dueños.
      </p>
    </div>
    <div class="flex flex-col items-start gap-2 font-display text-xs tracking-wide text-paper-300">
      <a
        href="https://github.com/hell-over-studios/dexforge"
        class="underline-offset-4 hover:text-ember-300 hover:underline"
        rel="noopener noreferrer"
        target="_blank">GitHub <span aria-hidden="true">↗</span></a
      >
      <a
        href="https://raw.githubusercontent.com/PokeAPI/sprites"
        class="underline-offset-4 hover:text-ember-300 hover:underline"
        rel="noopener noreferrer"
        target="_blank"
        data-i18n="footer.art">Ilustraciones: PokeAPI</a
      >
      <span data-i18n="footer.license">Código bajo licencia MIT.</span>
      <span class="mt-1 text-paper-500">Fan-made · 2026</span>
    </div>
  </div>
</footer>
