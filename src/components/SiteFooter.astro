---
/** Colophon (ADR-012 «Revista»): black press band closing every page. */
import { withBase } from '../lib/paths';
import LogoMark from './LogoMark.astro';

const link =
  'kicker text-xs text-paper-200 underline-offset-4 decoration-2 decoration-ember-500 hover:text-ember-500 hover:underline';
---

<footer class="border-t-[3px] border-ink-950 bg-forest-950 forest-grain text-paper-100">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:px-8 md:grid-cols-[1.6fr_1fr]">
    <div>
      <a
        href={withBase('')}
        class="inline-flex items-center gap-3 underline-offset-4 hover:text-ember-500"
      >
        <span class="grid size-9 place-items-center border-2 border-paper-50 bg-ember-500">
          <LogoMark class="h-5 w-7" />
        </span>
        <span class="font-headline text-2xl tracking-wide text-ember-500 uppercase">Dexforge</span>
      </a>
      <p class="mt-4 max-w-xl text-xs leading-relaxed text-paper-300" data-i18n="footer.disclaimer">
        Proyecto de fans, sin afiliación con Nintendo, Game Freak ni The Pokémon Company. Pokémon y
        todos los nombres/efigies relacionados son propiedad de sus dueños.
      </p>
    </div>
    <div class="flex flex-col items-start gap-2">
      <span class="mb-1 kicker text-[11px] text-magenta-400" data-i18n="footer.colophon"
        >Colofón</span
      >
      <a
        href="https://github.com/hell-over-studios/dexforge"
        class={link}
        rel="noopener noreferrer"
        target="_blank">GitHub <span aria-hidden="true">↗</span></a
      >
      <a
        href="https://raw.githubusercontent.com/PokeAPI/sprites"
        class={link}
        rel="noopener noreferrer"
        target="_blank"
        data-i18n="footer.art">Ilustraciones: PokeAPI</a
      >
      <span class="kicker text-xs text-paper-300" data-i18n="footer.license"
        >Código bajo licencia MIT.</span
      >
      <span class="kicker text-xs text-paper-400">Fan-made · 2026</span>
    </div>
  </div>
</footer>
