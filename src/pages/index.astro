---
import Base from '../layouts/Base.astro';
import GameSelector from '../components/GameSelector.astro';
import PixelScene from '../components/PixelScene.astro';
import fs from 'node:fs';
import type { GamesRegistry, TypeData } from '../lib/data-schema';
import { dict, type DictKey } from '../lib/i18n';
import { GAME_FEATURED, HERO_TRIO } from '../lib/showcase';

const registry = JSON.parse(
  fs.readFileSync(new URL('../../public/data/games.json', import.meta.url), 'utf-8'),
) as GamesRegistry;

const typeData = JSON.parse(
  fs.readFileSync(new URL('../../public/data/types.json', import.meta.url), 'utf-8'),
) as TypeData;

const typeLookup = Object.fromEntries(
  typeData.types.map((t) => [t.slug, { name: t.name, color: t.color }]),
);

const heroMons = [
  {
    artwork: HERO_TRIO[0].artwork,
    name: HERO_TRIO[0].name.es,
    left: '4%',
    bottom: '9%',
    width: '33%',
    z: 4,
    delay: '0s',
  },
  {
    artwork: HERO_TRIO[1].artwork,
    name: HERO_TRIO[1].name.es,
    left: '38%',
    bottom: '5%',
    width: '26%',
    z: 4,
    delay: '0.7s',
  },
  {
    artwork: HERO_TRIO[2].artwork,
    name: HERO_TRIO[2].name.es,
    left: '64%',
    bottom: '8%',
    width: '31%',
    z: 4,
    delay: '1.4s',
  },
];

const heroTypes = ['grass', 'fire', 'water'];

const steps: { n: string; titleKey: DictKey; textKey: DictKey }[] = [
  { n: '01', titleKey: 'how.step1.title', textKey: 'how.step1.text' },
  { n: '02', titleKey: 'how.step2.title', textKey: 'how.step2.text' },
  { n: '03', titleKey: 'how.step3.title', textKey: 'how.step3.text' },
];

const features: {
  glyph: string;
  titleKey: DictKey;
  textKey: DictKey;
  accent: string;
  badge?: string;
}[] = [
  { glyph: '▦', titleKey: 'f.defense.title', textKey: 'f.defense', accent: 'bg-ember-500' },
  { glyph: '◍', titleKey: 'f.roles.title', textKey: 'f.roles', accent: 'bg-moss-500' },
  { glyph: '↗', titleKey: 'f.share.title', textKey: 'f.share', accent: 'bg-forest-600' },
  {
    glyph: '⌁',
    titleKey: 'f.offense.title',
    textKey: 'f.offense',
    accent: 'bg-paper-400',
    badge: 'v0.4',
  },
];
---

<Base>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <span
      aria-hidden="true"
      class="pointer-events-none absolute top-24 -left-8 size-24 rotate-12 bg-forest-800/40"></span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute top-40 right-4 size-3 bg-ember-500/60"></span>

    <div
      class="mx-auto grid max-w-6xl gap-12 px-5 pt-12 pb-16 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-14 lg:pt-20 lg:pb-24"
    >
      <div class="relative z-10 animate-fade-rise">
        <p class="kicker flex items-center gap-3 text-ember-300">
          <span aria-hidden="true" class="inline-block size-2 bg-ember-500"></span>
          <span data-i18n="hero.kicker">Proyecto de fans · datos abiertos</span>
        </p>

        <h1
          class="mt-5 font-display text-[clamp(2.9rem,6vw,4.6rem)] leading-[0.94] font-bold tracking-tight text-paper-50"
        >
          <span class="block" data-i18n="hero.title1">Tu equipo,</span>
          <span data-i18n="hero.title2">forjado para</span>{' '}
          <span class="relative inline-block">
            <span
              aria-hidden="true"
              class="absolute right-0 bottom-1 left-0 h-[0.38em] -rotate-1 bg-ember-500/90"></span>
            <span class="relative" data-i18n="hero.title3">tu juego.</span>
          </span>
        </h1>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-paper-300 sm:text-lg">
          <span data-i18n="hero.sub"
            >Elige uno de los juegos disponibles y arma tu equipo de seis con la tabla de tipos
            exacta de esa generación. Debilidades, roles y cobertura, sin hojas de cálculo.</span
          >
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#juegos" class="pixel-btn pixel-btn-primary">
            <span data-i18n="hero.cta">Elige tu juego</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href="#como-funciona" class="pixel-btn pixel-btn-quiet">
            <span data-i18n="hero.how">Cómo funciona</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <ul
          class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-2 font-display text-xs tracking-wide text-paper-300"
        >
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="size-2 bg-moss-400"></span>
            <span data-i18n="hero.proof.games">3 juegos</span>
          </li>
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="size-2 bg-ember-400"></span>
            <span data-i18n="hero.proof.mons">604 Pokémon</span>
          </li>
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="size-2 bg-paper-300"></span>
            <span data-i18n="hero.proof.charts">Tablas exactas</span>
          </li>
        </ul>
      </div>

      <div class="relative z-10 animate-fade-in">
        <div
          class="relative mx-auto w-full max-w-[30rem] rotate-[1.25deg] border-[3px] border-ink-950 bg-paper-50 p-3 shadow-[8px_8px_0_0_var(--color-ink-950)] sm:p-4"
        >
          <span
            aria-hidden="true"
            class="absolute -top-3 left-10 z-20 h-6 w-20 -rotate-3 border border-ink-900/20 bg-paper-300/80"
          ></span>
          <span
            aria-hidden="true"
            class="absolute -right-3 -bottom-3 z-20 h-6 w-24 rotate-2 border border-ink-900/20 bg-paper-300/80"
          ></span>
          <span
            class="absolute -top-5 -right-4 z-20 grid size-14 rotate-6 place-items-center border-2 border-ink-950 bg-ember-500 font-display text-lg leading-none text-ink-950 shadow-pixel-sm"
            aria-label="Equipo: 3 de 6"
          >
            3/6
          </span>

          <PixelScene
            variant="hero"
            mons={heroMons}
            class="h-[21rem] w-full border-2 border-ink-950 sm:h-[25rem]"
          />

          <div
            class="mt-3 flex flex-wrap items-center justify-between gap-2 border-2 border-ink-950 bg-paper-100 px-3 py-2"
          >
            <span class="font-display text-sm text-ink-900" data-i18n="hero.caption"
              >Ruta 101 · Hoenn</span
            >
            <span class="flex flex-wrap gap-1">
              {
                heroTypes.map((t) => {
                  const meta = typeLookup[t];
                  return (
                    <span class="type-chip" style={`background-color:${meta?.color ?? '#9299a1'};`}>
                      <span data-i18n-pair={JSON.stringify(meta?.name ?? { es: t, en: t })}>
                        {meta?.name.es ?? t}
                      </span>
                    </span>
                  );
                })
              }
            </span>
          </div>
        </div>

        <p
          class="mt-6 text-center font-display text-[10px] tracking-[0.18em] text-paper-400 uppercase"
          data-i18n="hero.art"
        >
          Ilustraciones oficiales · PokeAPI
        </p>
      </div>
    </div>
  </section>

  <!-- GAME SELECTOR -->
  <section
    id="juegos"
    class="scroll-mt-24 border-y-2 border-forest-800 bg-forest-900/70 py-16 sm:py-20"
    aria-labelledby="games-h"
  >
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="kicker text-ember-300" data-i18n="selector.kicker">01 · Elige tu partida</p>
          <h2
            id="games-h"
            class="mt-2 font-display text-4xl leading-none text-paper-50 sm:text-5xl"
            data-i18n="selector.heading"
          >
            Elige tu juego
          </h2>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-paper-300 sm:text-base">
            <span data-i18n="selector.sub"
              >Tres regiones, tres tablas de tipos y cero aproximaciones. Entra y empieza a montar
              el equipo.</span
            >
          </p>
        </div>
        <p class="font-display text-xs tracking-wide text-paper-400" data-i18n="selector.count">
          151 + 251 + 202 Pokémon
        </p>
      </div>

      <div class="mt-8">
        <GameSelector games={registry.games} featured={GAME_FEATURED} typeLookup={typeLookup} />
      </div>

      <p class="mt-6 font-display text-xs tracking-wide text-paper-400">
        <span data-i18n="selector.missing">¿Falta tu juego?</span>
        <a
          href="https://github.com/hell-over-studios/dexforge/issues"
          class="ml-1 text-ember-300 underline underline-offset-4 hover:text-ember-400"
          rel="noopener noreferrer"
          target="_blank"
          data-i18n="selector.missingLink">Pídelo en GitHub</a
        >
        <span aria-hidden="true">↗</span>
      </p>
    </div>
  </section>

  <!-- HOW IT WORKS + FEATURES -->
  <section
    id="como-funciona"
    class="mx-auto max-w-6xl scroll-mt-24 px-5 py-16 sm:px-8 sm:py-24"
    aria-labelledby="how-h"
  >
    <div class="max-w-2xl">
      <p class="kicker text-ember-300" data-i18n="how.kicker">02 · Cómo funciona</p>
      <h2
        id="how-h"
        class="mt-2 font-display text-4xl leading-none text-paper-50 sm:text-5xl"
        data-i18n="how.heading"
      >
        Del juego a la decisión.
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-paper-300 sm:text-base">
        <span data-i18n="how.sub"
          >Tres pasos. Sin cuentas, sin anuncios y sin cambiar de pestaña.</span
        >
      </p>
    </div>

    <ol class="mt-10 grid gap-4 md:grid-cols-3">
      {
        steps.map((step) => (
          <li class="paper-panel-soft relative overflow-hidden p-5">
            <span
              aria-hidden="true"
              class="absolute -top-2 right-2 font-display text-6xl leading-none text-ink-900/10"
            >
              {step.n}
            </span>
            <span aria-hidden="true" class="mb-4 block h-2 w-12 bg-ember-500" />
            <h3 class="font-display text-xl text-ink-950" data-i18n={step.titleKey}>
              {dict[step.titleKey].es}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600" data-i18n={step.textKey}>
              {dict[step.textKey].es}
            </p>
          </li>
        ))
      }
    </ol>

    <div class="mt-16 max-w-2xl">
      <p class="kicker text-moss-400" data-i18n="features.kicker">03 · Ya dentro</p>
      <h2
        class="mt-2 font-display text-4xl leading-none text-paper-50 sm:text-5xl"
        data-i18n="features.heading"
      >
        Lo que ya está forjado.
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-paper-300 sm:text-base">
        <span data-i18n="features.sub">Funciones reales sobre datos reales. Nada de maquetas.</span>
      </p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        features.map((feature) => (
          <div class="border-2 border-ink-950 bg-paper-50 p-5 shadow-pixel">
            <div class="flex items-center gap-3">
              <span
                aria-hidden="true"
                class={`grid size-10 shrink-0 place-items-center border-2 border-ink-950 font-display text-xl text-paper-50 ${feature.accent}`}
              >
                {feature.glyph}
              </span>
              <h3 class="font-display text-lg text-ink-950" data-i18n={feature.titleKey}>
                {dict[feature.titleKey].es}
              </h3>
              {feature.badge ? (
                <span class="ml-auto border-2 border-ink-950 bg-ember-500 px-1.5 py-0.5 font-display text-[10px] leading-none text-ink-950 uppercase">
                  {feature.badge}
                </span>
              ) : null}
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink-600" data-i18n={feature.textKey}>
              {dict[feature.textKey].es}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
    <div
      class="relative overflow-hidden border-[3px] border-ink-950 bg-paper-100 paper-grain p-7 shadow-pixel-lg sm:p-12"
    >
      <span aria-hidden="true" class="pixel-rule absolute top-0 right-0 left-0"></span>
      <div class="relative z-10 max-w-2xl">
        <p class="kicker text-ember-700">Dexforge</p>
        <h2
          class="mt-2 font-display text-4xl leading-[0.98] text-balance text-ink-950 sm:text-5xl"
          data-i18n="cta.heading"
        >
          Tu próxima partida empieza con un equipo.
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-600 sm:text-base" data-i18n="cta.sub">
          Elige la región y forja el tuyo. Se guarda en tu navegador.
        </p>
        <a href="#juegos" class="pixel-btn pixel-btn-primary mt-6">
          <span data-i18n="cta.button">Empezar a forjar</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <svg
        viewBox="0 0 8 8"
        class="pointer-events-none absolute right-6 bottom-6 hidden w-48 rotate-3 opacity-25 lg:block"
        shape-rendering="crispEdges"
        aria-hidden="true"
      >
        <rect width="8" height="8" fill="#241c12"></rect>
        <rect x="2" y="1" width="4" height="1" fill="#f7931e"></rect>
        <rect x="1" y="2" width="6" height="1" fill="#f7931e"></rect>
        <rect x="1" y="3" width="6" height="2" fill="#fbf5e6"></rect>
        <rect x="3" y="3" width="2" height="2" fill="#241c12"></rect>
        <rect x="1" y="5" width="6" height="1" fill="#c3a473"></rect>
        <rect x="2" y="6" width="4" height="1" fill="#c3a473"></rect>
      </svg>
    </div>
  </section>
</Base>
