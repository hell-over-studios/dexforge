---
/**
 * Game workbench (ADR-012 «Revista»): an edition opener, then "Tu sexteto"
 * (team sheet) across the top and a two-column desk — the index (search,
 * drawer) on the left, the analysis in tabs on the right (sticky on desktop,
 * each column scrolls on its own). Every island reads the static
 * /data/<game>.json; the deployed site never calls PokeAPI.
 */
import Base from '../../layouts/Base.astro';
import Picker from '../../components/Picker';
import TeamSlots from '../../components/TeamSlots';
import DefenseCharts from '../../components/DefenseCharts';
import OffensiveCoverage from '../../components/OffensiveCoverage';
import TeamProfile from '../../components/TeamProfile';
import AnalysisTabs from '../../components/AnalysisTabs';
import fs from 'node:fs';
import type { GameRegistryEntry, GamesRegistry } from '../../lib/data-schema';
import { withBase } from '../../lib/paths';

/* Build-time static pages, one per game in the registry. */
export function getStaticPaths() {
  const registry = JSON.parse(
    fs.readFileSync(new URL('../../../public/data/games.json', import.meta.url), 'utf-8'),
  ) as GamesRegistry;
  return registry.games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

interface Props {
  game: GameRegistryEntry;
}

const { game } = Astro.props;
const title = `Dexforge — ${game.label.es}`;
const description =
  'Team builder de Pokémon por juego: estadísticas, tabla de tipos exacta por generación, cobertura, localizaciones de captura y enfrentamientos contra líderes de gimnasio. Proyecto de fans, de código abierto.';
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

/* same version colors as the edition cards on the home page */
const COVER: Record<string, string> = {
  'red-blue': 'linear-gradient(120deg, #e3262b 0 52%, #2f6bd8 52% 100%)',
  'gold-silver': 'linear-gradient(120deg, #d9a520 0 52%, #aab4bf 52% 100%)',
  emerald: 'linear-gradient(120deg, #17a35e 0 100%)',
};
const typesInChart = game.generation === 1 ? 15 : 17;
---

<Base title={title} description={description}>
  <!-- EDITION OPENER -->
  <section class="border-b-[3px] border-ink-950 bg-paper-100">
    <div class="mx-auto max-w-7xl px-5 pt-6 pb-7 sm:px-8">
      <a
        href={withBase('')}
        class="inline-flex items-center gap-2 kicker text-xs text-ink-700 decoration-magenta-500 decoration-2 underline-offset-4 hover:text-ink-950 hover:underline"
      >
        <span aria-hidden="true">←</span>
        <span data-i18n="game.back">Volver al inicio</span>
      </a>

      <div class="mt-4 flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="kicker text-xs text-magenta-600">
            <span data-i18n="game.kicker">Edición</span> · Gen {game.generation} ·
            {capitalize(game.region)}
          </p>
          <h1
            class="mt-1 text-[clamp(3.2rem,9vw,6.5rem)] leading-[0.88] text-ink-950 uppercase"
            data-i18n-pair={JSON.stringify(game.label)}
          >
            {game.label.es}
          </h1>
        </div>

        <dl class="flex flex-wrap gap-3">
          <div class="border-2 border-ink-950 bg-paper-50 px-3 py-2 shadow-pixel-sm">
            <dt class="kicker text-[10px] text-ink-600">Pokémon</dt>
            <dd class="font-headline text-3xl leading-none text-ink-950">{game.pokemonCount}</dd>
          </div>
          <div class="border-2 border-ink-950 bg-paper-50 px-3 py-2 shadow-pixel-sm">
            <dt class="kicker text-[10px] text-ink-600" data-i18n="game.types">
              tipos en la tabla
            </dt>
            <dd class="font-headline text-3xl leading-none text-ink-950">{typesInChart}</dd>
          </div>
          <div class="border-2 border-ink-950 bg-paper-50 px-3 py-2 shadow-pixel-sm">
            <dt class="kicker text-[10px] text-ink-600" data-i18n="game.dexStamp">
              Pokédex regional
            </dt>
            <dd class="font-headline text-3xl leading-none text-ink-950">
              {capitalize(game.region)}
            </dd>
          </div>
        </dl>
      </div>
    </div>
    <div
      class="h-3 border-t-[3px] border-ink-950"
      style={`background:${COVER[game.id] ?? '#0e0e0e'}`}
      aria-hidden="true"
    >
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-5 pt-8 pb-20 sm:px-8">
    <!-- TEAM SHEET (T2.8) — its own island, seeded from ?t= links -->
    <section aria-label="Tu equipo">
      <noscript>
        <p class="paper-panel-soft p-4 text-sm text-ink-600">
          El creador de equipos necesita JavaScript para buscar Pokémon.
        </p>
      </noscript>
      <TeamSlots client:load gameId={game.id} />
    </section>

    <!-- DESK: index on the left, analysis tabs on the right -->
    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-start">
      <section aria-label="Seleccionar Pokémon" class="lg:sticky lg:top-20">
        <Picker client:load gameId={game.id} />
      </section>

      <div
        class="lg:sticky lg:top-20 lg:max-h-[calc(100dvh-7rem)] lg:overflow-y-auto lg:pr-2 lg:pb-2"
      >
        <AnalysisTabs client:load gameId={game.id} />

        <div id="panel-defensa" role="tabpanel" aria-labelledby="tab-defensa" class="mt-5">
          <section aria-label="Análisis defensivo del equipo">
            <DefenseCharts client:visible gameId={game.id} />
          </section>
        </div>
        <div
          id="panel-cobertura"
          role="tabpanel"
          aria-labelledby="tab-cobertura"
          class="mt-5"
          hidden
        >
          <section aria-label="Cobertura ofensiva del equipo">
            <OffensiveCoverage client:visible gameId={game.id} />
          </section>
        </div>
        <div id="panel-perfil" role="tabpanel" aria-labelledby="tab-perfil" class="mt-5" hidden>
          <section aria-label="Perfil del equipo">
            <TeamProfile client:visible gameId={game.id} />
          </section>
        </div>
      </div>
    </div>
  </div>
</Base>
