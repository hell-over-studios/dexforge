---
import Base from '../../layouts/Base.astro';
import Picker from '../../components/Picker';
import DefenseCharts from '../../components/DefenseCharts';
import OffensiveCoverage from '../../components/OffensiveCoverage';
import TeamProfile from '../../components/TeamProfile';
import fs from 'node:fs';
import type { GameRegistryEntry, GamesRegistry } from '../../lib/data-schema';
import { withBase } from '../../lib/paths';

/* Build-time static pages, one per game in the registry (no client JS). */
export function getStaticPaths() {
  const registry = JSON.parse(
    fs.readFileSync(new URL('../../../public/data/games.json', import.meta.url), 'utf-8'),
  ) as GamesRegistry;
  return registry.games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

interface Props {
  game: GameRegistryEntry;
}

const { game } = Astro.props;
const title = `Dexforge — ${game.label.es}`;
const description =
  'Team builder de Pokémon por juego: estadísticas, tabla de tipos exacta por generación, cobertura, localizaciones de captura y enfrentamientos contra líderes de gimnasio. Proyecto de fans, de código abierto.';
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<Base title={title} description={description}>
  <div class="mx-auto max-w-6xl px-5 pt-8 pb-20 sm:px-8">
    <a
      href={withBase('')}
      class="inline-flex items-center gap-2 font-display text-sm text-paper-300 underline-offset-4 transition-colors hover:text-ember-300 hover:underline"
    >
      <span aria-hidden="true">←</span>
      <span data-i18n="game.back">Volver al inicio</span>
    </a>

    <header class="paper-panel relative mt-6 overflow-hidden p-5 sm:p-7">
      <span aria-hidden="true" class="absolute top-0 right-0 left-0 h-1.5 bg-ember-500"></span>
      <div class="flex flex-wrap items-center justify-between gap-6">
        <div>
          <h1
            class="font-display text-4xl leading-none text-ink-950 sm:text-5xl"
            data-i18n-pair={JSON.stringify(game.label)}
          >
            {game.label.es}
          </h1>
          <p class="mt-3 text-sm text-ink-600">
            Gen {game.generation} ·{' '}
            <span class="font-display text-base text-ink-900">{game.pokemonCount}</span> Pokémon ·{
              ' '
            }
            {capitalize(game.region)}
          </p>
        </div>

        <div class="hidden rotate-2 items-center gap-3 text-ink-700 sm:flex" aria-hidden="true">
          <svg viewBox="0 0 8 8" class="size-9" shape-rendering="crispEdges">
            <rect width="8" height="8" fill="#241c12"></rect>
            <rect x="2" y="1" width="4" height="1" fill="#f7931e"></rect>
            <rect x="1" y="2" width="6" height="1" fill="#f7931e"></rect>
            <rect x="1" y="3" width="6" height="2" fill="#fbf5e6"></rect>
            <rect x="3" y="3" width="2" height="2" fill="#241c12"></rect>
            <rect x="1" y="5" width="6" height="1" fill="#c3a473"></rect>
            <rect x="2" y="6" width="4" height="1" fill="#c3a473"></rect>
          </svg>
          <span
            class="font-display text-[11px] leading-tight tracking-[0.18em] text-ink-900 uppercase"
            data-i18n="game.dexStamp">Pokédex regional</span
          >
        </div>
      </div>
    </header>

    <!-- Pokémon picker island (T2.5) — data is the static /data/<game>.json -->
    <section aria-label="Seleccionar Pokémon" class="mt-6">
      <noscript>
        <p class="paper-panel-soft p-4 text-sm text-ink-600">
          El creador de equipos necesita JavaScript para buscar Pokémon.
        </p>
      </noscript>
      <Picker client:visible gameId={game.id} />
    </section>

    <!-- Defensive analysis island (T3.2) — reads the same static /data JSON -->
    <section aria-label="Análisis defensivo del equipo" class="mt-6">
      <DefenseCharts client:visible gameId={game.id} />
    </section>

    <!-- Offensive coverage island (T4.3) — picked moves vs the per-game chart -->
    <section aria-label="Cobertura ofensiva del equipo" class="mt-6">
      <OffensiveCoverage client:visible gameId={game.id} />
    </section>

    <!-- Team profile island (T3.3) — averages + roles, same static JSON -->
    <section aria-label="Perfil del equipo" class="mt-6">
      <TeamProfile client:visible gameId={game.id} />
    </section>
  </div>
</Base>
